# ===========================================
# FINBOT BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this to .env and fill in your values
# For Railway: Add these as Environment Variables in the dashboard

# ----- REQUIRED: Angel One Broker -----
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_pin
ANGEL_TOTP_SECRET=your_totp_secret

# ----- REQUIRED: Supabase -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ----- REQUIRED: Redis (Upstash) -----
# For Upstash, use rediss:// (with double s for SSL)
REDIS_URL=rediss://default:your_password@your-region.upstash.io:6379

# ----- TRADING CONFIGURATION -----
TRADING_MODE=paper
TRADING_CAPITAL=15000

# ----- OPTIONAL: API Configuration -----
# Railway will override PORT automatically
PORT=8000

# CORS origins (comma-separated, without spaces around commas)
# Add your frontend URL here
CORS_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# Frontend URL (for any server-side redirects)
FRONTEND_URL=http://localhost:5173

# ----- OPTIONAL: Data Storage -----
# For Railway, use a mounted volume path
BACKTEST_DATA_DIR=data/historical

# ----- OPTIONAL: Logging -----
LOG_LEVEL=INFO
